# Highrise Bot Configuration
# Get Room ID from Highrise app (Room info -> Share this Room)
ROOM_ID=your_room_id_here

# Get API Token from Highrise Create Portal (https://create.highrise.game -> Dashboard -> Bots & API Keys)
API_TOKEN=your_api_token_here

# HTTP Port for Render keep-alive web server (Render automatically sets this, 8080 for local)
PORT=8080

# Command Prefix (default is !)
BOT_PREFIX=!

# Custom Welcome Message ({username} will be replaced with user's handle)
WELCOME_MESSAGE=Welcome to the room, @{username}! Type !help for commands.
