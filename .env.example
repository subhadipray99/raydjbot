# Highrise Bot Configuration
# Get Room ID from Highrise app (Room info -> Share this Room)
ROOM_ID=your_room_id_here

# Get API Token from Highrise Create Portal (https://create.highrise.game -> Dashboard -> Bots & API Keys)
API_TOKEN=your_api_token_here

# Room Owner username (exact Highrise handle, grants admin rights for !fit, !setpos, !setfloor)
ROOM_OWNER=your_username_here

# Room Display Name (used in welcome whisper messages)
ROOM_TITLE=My Lounge

# Custom Bot Display Name (online announcements)
BOT_DISPLAY_NAME=RayDJBot

# HTTP Port for Render keep-alive web server (Render automatically sets this, 8080 for local)
PORT=8080

# Command Prefix (default is !)
BOT_PREFIX=!

# 24/7 Autoplay Radio settings
AUTOPLAY_ENABLED=true
AUTOPLAY_INSTANT_TAKEOVER=true
AUTOPLAY_CHAT_ANNOUNCEMENTS=true
